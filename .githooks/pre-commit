#!/usr/bin/env bash
# Format and lint staged Swift files, then build. Install once: git config core.hooksPath .githooks
set -euo pipefail

files=$(git diff --cached --name-only --diff-filter=ACM -- '*.swift')
if [ -n "$files" ]; then
    # shellcheck disable=SC2086
    swift format format --in-place $files
    # shellcheck disable=SC2086
    git add $files
    # shellcheck disable=SC2086
    swift format lint --strict $files
fi
swift build
