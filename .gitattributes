# Shell scripts must keep LF endings or bash fails on Windows checkouts (autocrlf).
*.sh text eol=lf
# Swift sources and config stay LF so swift-format sees the same bytes on Windows and CI.
*.swift text eol=lf
*.yml text eol=lf
.swift-format text eol=lf
.githooks/* text eol=lf
# Specs, plans, docs and skills stay LF too: scripted edits on Windows then match the same
# bytes as everywhere else, and commits stop warning "LF will be replaced by CRLF".
*.md text eol=lf
